# Form submissions: regular (application/x-www-form-urlencoded), multipart
# (multipart/form-data with text fields), and multipart file upload.
#
# Run `make httpbin-up` from the repo root first (requires Docker).

###
# @name UrlEncoded
POST http://localhost:8080/post HTTP/1.1
Content-Type: application/x-www-form-urlencoded

username=alice&password=s3cret&remember=true

###
# @name Multipart
# The boundary in Content-Type must match the "--<boundary>" markers in
# the body exactly (including the trailing "--" on the very last one).
POST http://localhost:8080/post HTTP/1.1
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="username"

alice
--WebAppBoundary
Content-Disposition: form-data; name="bio"

Hello from httpfly
--WebAppBoundary--

###
# @name FileUpload
# "< ./path" reads a file's content in place of that part's body -- the
# path is resolved relative to THIS .http file's own directory (not
# httpyac's process cwd, which can be different -- see 6_shell_auth.http),
# so this works regardless of where httpyac actually gets invoked from.
POST http://localhost:8080/post HTTP/1.1
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="description"

sample upload
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample-upload.txt"
Content-Type: text/plain

< ./sample-upload.txt
--WebAppBoundary--
