# httpfly.nvim always runs httpyac with --json (that's what lets it render
# the markdown response view), and under --json, console.log/info/warn
# calls in scripts are silently dropped -- not shown anywhere (see
# "Scripting notes" in the README). client.test(...) is the workaround:
# its messages *do* survive --json and get rendered as a "Test Results"
# section, so it doubles as a debug-dump tool, not just an assertion API.
#
# Run `make httpbin-up` from the repo root first (requires Docker).

###
# @name Get
GET http://localhost:8080/get?foo=bar HTTP/1.1

> {%
  // client.test(label, fn) only marks a failure if fn *throws* -- a plain
  // `return false` inside fn does nothing, it still shows as passed. So a
  // test whose callback always returns/does nothing but true is really
  // just "print this label", which is exactly what we want for dumping
  // values while debugging: build whatever you want to see into the label
  // string itself.
  client.test("status: " + response.status, () => true);
  client.test("origin: " + response.body.origin, () => true);
  client.test("full body: " + JSON.stringify(response.body), () => true);

  // for an actual pass/fail check (renders ✅ or ❌ depending on the
  // outcome), throw inside the callback -- client.assert(condition, message)
  // does that for you when condition is false
  client.test("status is 200", () => client.assert(response.status === 200, "expected 200, got " + response.status));
%}
