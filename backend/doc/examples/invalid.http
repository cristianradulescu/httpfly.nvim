# A grab-bag of broken/questionable requests, one issue per block, for
# exercising `httpfly validate doc/examples/invalid.http`. Not meant to be
# run -- most of these would fail to send anyway. See 1_basic.http and
# 2_variables.http for well-formed examples.
#
# "name" is local-only metadata (a global name makes no sense), so the line
# below is itself an [ERROR], reported under a "(global)" section rather
# than attached to any one request.
# @name NotAllowedGlobally

###
# Missing @name -- otherwise a perfectly fine request. [ERROR]
GET http://localhost:8080/get HTTP/1.1

###
# @name
# Empty @name value. [ERROR]
GET http://localhost:8080/get HTTP/1.1

###
# @name RelativeURL
# URL has no scheme/host. [ERROR]
GET /get HTTP/1.1

###
# @name BadHeader
# Header line missing the ":" separator. [ERROR]
GET http://localhost:8080/get HTTP/1.1
X-Broken-Header

###
# @name Scripting
# Invalid Lua syntax inside the pre-request script. [ERROR]
< {%
  this is not valid lua (((
%}

GET http://localhost:8080/get HTTP/1.1

###
# @name UnknownMetadata
# "@timeout" is recognized syntax but isn't a supported directive. [WARN]
# @timeout 30
GET http://localhost:8080/get HTTP/1.1

###
# @name NonStandardMethod
# "FETCH" isn't a real HTTP method. [WARN]
FETCH http://localhost:8080/get HTTP/1.1

###
# @name UnrecognizedProto
# "WEIRD/9" doesn't look like an HTTP version. [WARN]
GET http://localhost:8080/get WEIRD/9

###
# @name UndefinedVariable
# {{missing_var}} has no matching "@missing_var = ..." declaration. [WARN]
GET http://localhost:8080/get?token={{missing_var}} HTTP/1.1

###
# @name BadProxy
# @proxy is metadata, so it needs a scheme+host like any other URL. [ERROR]
# @proxy localhost:3128
GET http://localhost:8080/get HTTP/1.1


### DuplicatedName1
# @name DuplicatedName2
GET http://localhost:8080/get HTTP/1.1

###
# @name SameNameTwice
# First of two blocks sharing a @name -- this one is fine on its own.
GET http://localhost:8080/get HTTP/1.1

###
# @name SameNameTwice
# Reuses the @name above, so "-name SameNameTwice" would be ambiguous. [ERROR]
GET http://localhost:8080/get HTTP/1.1

###
# @name MetadataAfterRequestLine
GET http://localhost:8080/get HTTP/1.1
# @proxy http://localhost:3128
# Metadata among the headers -- it must come before the request line. [ERROR]
# (A plain comment like this one is fine here, and so is a commented-out
# header -- that's how you disable one temporarily.)
Accept: application/json

###
# @name VariableCycle
# @a and @b each refer to the other, so {{a}} can never be resolved. [ERROR]
@a = {{b}}
@b = {{a}}
GET http://localhost:8080/get?x={{a}} HTTP/1.1
