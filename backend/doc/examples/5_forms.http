# Form submissions: regular (application/x-www-form-urlencoded) and
# multipart (multipart/form-data with text fields), no scripting involved.
# See 8_file_upload.http for a multipart part whose content is an actual
# file's bytes, via "< ./path" -- these two fields are plain text instead.
#
# Run `make httpbin-up` first.

###
# @name UrlEncoded
POST http://localhost:8080/post HTTP/1.1
Content-Type: application/x-www-form-urlencoded

username=alice&password=s3cret&remember=true

###
# @name Multipart
# The boundary in Content-Type must match the "--<boundary>" markers in
# the body exactly (including the trailing "--" on the very last one).
POST http://localhost:8080/post HTTP/1.1
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="username"

alice
--WebAppBoundary
Content-Disposition: form-data; name="bio"

Hello from httpfly
--WebAppBoundary--
